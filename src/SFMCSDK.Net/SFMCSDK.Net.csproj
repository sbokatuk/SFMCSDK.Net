<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../Sfmc.Facade.props" />

  <PropertyGroup>
    <PackageId>SFMCSDK.Net</PackageId>
    <Title>Salesforce Marketing Cloud SFMC SDK for .NET, cross-platform</Title>
    <Description>
      One cross-platform API for the Salesforce Marketing Cloud SFMC SDK core: awaitable
      initialization, identity (contact key and attributes) and custom event tracking on Android
      and iOS from shared code, over the SFMCSDK.Net.Android and SFMCSDK.Net.iOS bindings.
      Restores on plain target frameworks too, so shared class libraries and unit tests need no
      platform conditionals.
    </Description>
    <PackageTags>salesforce;marketingcloud;sfmc;sfmcsdk;maui;android;ios;identity;events;binding</PackageTags>
  </PropertyGroup>

  <!--
    The neutral head is ordinary managed code with no native dependency, so the logic that lives
    there - argument validation, the one-shot initialization guard, the timeout mechanics - is
    testable in milliseconds without a device. SFMCSDK.Net.UnitTests is where that happens.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="SFMCSDK.Net.UnitTests" />
  </ItemGroup>

  <!--
    The platform binding packages, pinned EXACTLY with a bracketed range rather than as the
    floating minimum a bare version would be. The façade calls each binding's hand-written
    convenience layer (the Action overloads of Configure/RequestSdk are the Android package's
    Additions; the Func-typed Identity.Edit trampoline is the iOS binding's hand tuning), and
    neither layer carries a compatibility promise beyond "the pinned revision has them" - a
    consumer floated onto a newer binding would discover any mismatch at runtime. Moving a pin is
    a deliberate edit in Directory.Build.props, followed by the e2e suites.
  -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PackageReference Include="SFMCSDK.Net.Android" Version="[$(SfmcAndroidPackageVersion)]" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <PackageReference Include="SFMCSDK.Net.iOS" Version="[$(SfmcIosPackageVersion)]" />
  </ItemGroup>

</Project>
