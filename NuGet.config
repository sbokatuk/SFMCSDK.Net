<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      Locally packed packages. Two things resolve from here: the SFMCSDK.Net the device tests and
      the sample consume - the packed .nupkg rather than the project, so both run against exactly
      what gets published, dependency groups included - and, during local development against
      unreleased platform bindings, the SFMCSDK.Net.Android / SFMCSDK.Net.iOS packages the sibling
      repositories' own BuildNugets.sh dropped in ./artifacts. On a clean clone the platform
      packages come from nuget.org instead; the pins in Directory.Build.props resolve identically
      either way.
    -->
    <add key="local-artifacts" value="artifacts" />
  </packageSources>
</configuration>
